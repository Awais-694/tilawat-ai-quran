# Ignore large full-book PDFs in public root
/public/*.pdf

# Allow Surah PDFs for 16-line reading, tarjama, and tajweed
!/public/mushaf16/surahs/*.pdf
!/public/tarjama/surahs/*.pdf
!/public/tajweed/surahs/*.pdf

